{
  "name": "rm-miner",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22.23.3"
    }
  },
  "remoteUser": "vscode",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "remoteEnv": {
    "PATH": "${containerWorkspaceFolder}/.venv/bin:${containerEnv:PATH}",
    "VIRTUAL_ENV": "${containerWorkspaceFolder}/.venv",
    "GITHUB_TOKEN": "${localEnv:GITHUB_TOKEN}",
    "REPORTER_API_KEY": "${localEnv:REPORTER_API_KEY}",
    "REPORTER_MODEL": "${localEnv:REPORTER_MODEL}",
    "REPORTER_API_URL": "${localEnv:REPORTER_API_URL}"
  },
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": {
      "label": "rm-miner Visualizer",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "dbaeumer.vscode-eslint"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"]
      }
    }
  }
}
